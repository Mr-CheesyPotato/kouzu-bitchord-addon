{
  "rewrites": [
    { "source": "/manifest.json", "destination": "/api/manifest.json" },
    { "source": "/search", "destination": "/api/search" },
    { "source": "/stream/:id", "destination": "/api/stream?id=:id" },
    { "source": "/media", "destination": "/api/media" },
    { "source": "/extras/:resource", "destination": "/api/extras?resource=:resource" }
  ]
}
